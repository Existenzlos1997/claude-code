<?xml version="1.0" encoding="UTF-8"?>
<svg width="350" height="120" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ff6b6b;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#feca57;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#48dbfb;stop-opacity:1" />
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="3" stdDeviation="3" flood-color="#000" flood-opacity="0.5"/>
    </filter>
  </defs>
  <text x="175" y="70" font-family="Arial Black" font-size="48" font-weight="bold" fill="url(#logoGrad)" text-anchor="middle" filter="url(#shadow)">URBAN</text>
  <text x="175" y="110" font-family="Arial Black" font-size="36" font-weight="bold" fill="#FFF" text-anchor="middle" filter="url(#shadow)">SCUM</text>
</svg>