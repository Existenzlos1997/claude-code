{
  "name": "cross-platform-game-system",
  "version": "1.2.0",
  "description": "Revolutionary AI-powered cross-platform game compatibility system / Revolutionäres KI-gestütztes plattformübergreifendes Spiele-Kompatibilitätssystem",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "setup": "node scripts/setup.js",
    "wizard": "node scripts/wizard.js",
    "detect-games": "node src/detection/detect.js",
    "add-game": "node src/launchers/add-game.js",
    "launch": "node src/launchers/launch.js",
    "check-anticheat": "node src/compatibility/check-anticheat.js",
    "list-profiles": "node scripts/game-profiles.js list",
    "show-profile": "node scripts/game-profiles.js show",
    "search-profiles": "node scripts/game-profiles.js search",
    "simulate": "node scripts/simulate-test.js",
    "gui": "electron src/gui/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:all": "node scripts/test-all.js",
    "validate": "node scripts/validate-system.js",
    "build": "npm run build:core && npm run build:gui",
    "build:core": "echo 'Building core...'",
    "build:gui": "echo 'Building GUI...'"
  },
  "keywords": [
    "games",
    "cross-platform",
    "wine",
    "proton",
    "compatibility",
    "windows",
    "linux",
    "gaming"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "conf": "^11.0.0",
    "execa": "^5.1.1",
    "glob": "^10.0.0",
    "ini": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "jest": "^29.0.0",
    "nodemon": "^3.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
