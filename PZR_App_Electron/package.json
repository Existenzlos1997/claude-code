{
  "name": "pzr-app-desktop",
  "version": "1.0.0",
  "description": "PZR Praxis Management - Desktop App mit Backend-Server",
  "main": "main.js",
  "author": "Zahnärzte Burgau",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "sqlite3": "^5.1.6",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.burgau.pzr-app",
    "productName": "PZR Praxis Manager",
    "artifactName": "pzr-app-latest.${ext}",
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/sqlite3/lib/binding/**",
      "**/node_modules/bindings/**",
      "**/node_modules/file-uri-to-path/**"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "app/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "deb",
      "category": "Office",
      "maintainer": "Zahnärzte Burgau <info@zahnaerzte-burgau.de>"
    }
  }
}
