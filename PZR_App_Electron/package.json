{
  "name": "pzr-app-desktop",
  "version": "1.0.0",
  "description": "PZR Praxis Manager - Desktop App mit Backend-Server",
  "main": "main.js",
  "author": "PZR Praxis Manager",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "sqlite3": "^5.1.6",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.pzr.praxis-manager",
    "productName": "PZR Praxis Manager",
    "artifactName": "pzr-app-latest.${ext}",
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "Existenzlos1997",
      "repo": "claude-code"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "app/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "server.js",
      "node_modules/sqlite3/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "deb",
      "category": "Office",
      "maintainer": "PZR Praxis Manager"
    }
  }
}
